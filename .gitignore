# ── Python ────────────────────────────────────────────────────────────────────

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/
*.cover

# ── Environment & Secrets ─────────────────────────────────────────────────────

# Never commit real environment files — use .env.example instead
.env

# ── Database & Storage ────────────────────────────────────────────────────────

# SQLite database — regenerated on setup
*.db
*.sqlite
*.sqlite3

# ChromaDB vector store — regenerated by running the embedder
data/chroma_db/
data/test_chroma_db/

# ── Frontend ──────────────────────────────────────────────────────────────────

# Node modules — restored with npm install
frontend/node_modules/

# Vite build output
frontend/dist/
frontend/dist-ssr/

# Local env files created by Vite
frontend/*.local

# ESLint cache
frontend/.eslintcache

# ── OS & Editor ───────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/*
!.vscode/extensions.json

# JetBrains IDEs
.idea/

# ── Logs ──────────────────────────────────────────────────────────────────────

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*